@baseUrl = http://localhost:8080
@testEmail = wallet.demo.01@example.com
@testPassword = WalletTest2026!

### 1. Проверить работу приложения — 200
GET {{baseUrl}}/api/ping

### 2. Зарегистрировать пользователя — 201
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "Demo User",
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

> {%
    client.test("Пользователь создан", function () {
        client.assert(response.status === 201, "Ожидался статус 201");
    });

    if (response.status === 201) {
        client.global.set("demoUserId", response.body.id);
    }
%}

### 3. Войти — 200
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

> {%
    client.test("Вход выполнен", function () {
        client.assert(response.status === 200, "Ожидался статус 200");
    });

    if (response.status === 200) {
        client.global.set("demoToken", response.body.accessToken);
    }
%}

### 4. Создать кошелёк — 201
POST {{baseUrl}}/api/wallets
Authorization: Bearer {{demoToken}}
Content-Type: application/json

{
  "userId": {{demoUserId}},
  "currency": "RUB"
}

> {%
    client.test("Кошелёк создан", function () {
        client.assert(response.status === 201, "Ожидался статус 201");
    });

    if (response.status === 201) {
        client.global.set("demoWalletId", response.body.id);
    }
%}

### 5. Получить свой кошелёк — 200
GET {{baseUrl}}/api/wallets/{{demoWalletId}}
Authorization: Bearer {{demoToken}}

### 6. Пополнить на 1000 — 200
POST {{baseUrl}}/api/wallets/{{demoWalletId}}/deposit
Authorization: Bearer {{demoToken}}
Content-Type: application/json

{
  "amount": 1000.00
}

### 7. Снять 300 — 200
POST {{baseUrl}}/api/wallets/{{demoWalletId}}/withdraw
Authorization: Bearer {{demoToken}}
Content-Type: application/json

{
  "amount": 300.00
}

### 8. Посмотреть историю — 200
GET {{baseUrl}}/api/wallets/{{demoWalletId}}/transactions
Authorization: Bearer {{demoToken}}

### 9. Недостаточно средств — 409
POST {{baseUrl}}/api/wallets/{{demoWalletId}}/withdraw
Authorization: Bearer {{demoToken}}
Content-Type: application/json

{
  "amount": 999999.00
}

### 10. Отрицательная сумма — 400
POST {{baseUrl}}/api/wallets/{{demoWalletId}}/deposit
Authorization: Bearer {{demoToken}}
Content-Type: application/json

{
  "amount": -100.00
}

### 11. Неправильный пароль — 401
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "password": "WrongPassword123!"
}

### 12. Без токена — 401
GET {{baseUrl}}/api/wallets/{{demoWalletId}}

### 13. Чужой кошелёк №1 — 403
GET {{baseUrl}}/api/wallets/1
Authorization: Bearer {{demoToken}}

### 14. Перевод со своего кошелька на кошелёк №1 — 200
POST {{baseUrl}}/api/transfers
Authorization: Bearer {{demoToken}}
Content-Type: application/json

{
  "fromWalletId": {{demoWalletId}},
  "toWalletId": 1,
  "amount": 100.00
}

### 15. Проверить итоговый баланс — 200, баланс 600
GET {{baseUrl}}/api/wallets/{{demoWalletId}}
Authorization: Bearer {{demoToken}}